# Local defaults. The pipeline runs with these unset.
HC_STORAGE_MODE=local
HC_CATALOG_MODE=local
HC_LANDING=data/sample
HC_LOCAL_ROOT=data/lake
HC_LOG_DIR=data/logs

# Switch a laptop or Databricks job onto ADLS + Unity Catalog without code changes.
# HC_STORAGE_MODE=adls
# HC_CATALOG_MODE=unity
# HC_CATALOG_NAME=healthcare_dev
# HC_ADLS_URI=abfss://claims@sthcclaimsdev.dfs.core.windows.net/lake
# HC_LANDING_ADLS=abfss://claims@sthcclaimsdev.dfs.core.windows.net/landing

# Databricks / Azure credentials used only by the CD workflow and notebooks.
# DATABRICKS_HOST=https://adb-xxxxxxxxxxxxxxxx.azuredatabricks.net
# DATABRICKS_TOKEN=
# AZURE_CLIENT_ID=
# AZURE_TENANT_ID=
# AZURE_SUBSCRIPTION_ID=
# AZURE_CLIENT_SECRET=

# Optional alert sink. When unset, alerts are stored in audit.alert only.
# ALERT_WEBHOOK_URL=
